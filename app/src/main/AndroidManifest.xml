<?xml version="1.0" encoding="utf-8"?>
<!-- ... (라이선스 주석 등) ... -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.TYTgoogle.TYTfirebase.TYTexample">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirebaseDataConnect"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"> <!-- app_name을 사용하거나 특정 라벨을 지정합니다. -->
            <!-- android:theme 속성을 제거하여 Application의 테마를 상속받음 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        Jetpack Compose 방식에서는 별도의 PdfViewerActivity 선언이 필요하지 않을 수 있습니다.
        만약 필요하다면 아래 주석을 해제하고 exported 속성 등을 알맞게 설정하세요.
        <activity
            android:name=".PdfViewerActivity"
            android:exported="false" />
        -->

        <activity android:name=".SimpleTextActivity" />

        <!-- 외부 앱으로 PDF 열기 시 필요한 FileProvider 선언 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
